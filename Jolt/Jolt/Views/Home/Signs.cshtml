@model Jolt.Models.QuoteFormModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<SelectListItem> materials = new List<SelectListItem>
    {
        new SelectListItem() { Text = "Select a material...", Selected = true, Disabled = true },
        new SelectListItem() { Text = "Galvanized steel", Value = "Galvanized steel" },
        new SelectListItem() { Text = "Aluminum", Value = "Aluminum" },
        new SelectListItem() { Text = "Stainless steel", Value = "Stainless steel" },
        new SelectListItem() { Text = "Other (Specify in description)", Value = "Other" }
    };
}

<div class="container">
    <div class="row">
        <div class="panel panel-primary signsPanel">
            <div class="panel-heading">
                <h4>Custom Signs</h4>
            </div>
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    <h4>Submit a form to get a quote on a custom sign:</h4>
                    @using (Html.BeginForm("SubmitQuoteForm", "Home", FormMethod.Get))
                    {
                        @Html.TextBoxFor(m => m.Email, new { Placeholder = "Email", @class = "form-control", id = "emailTB", type = "email" })
                        @Html.DropDownList("Material", materials, new { @class = "form-control", id = "materialDD" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Width, new { Placeholder = "Width (\")", @class = "form-control", id = "widthTB" })
                            <span class="input-group-addon">&times;</span>
                            @Html.TextBoxFor(m => m.Height, new { Placeholder = "Height (\")", @class = "form-control", id = "heightTB" })
                        </div>
                        @Html.TextAreaFor(m => m.Description, new { PlaceHolder = "Description", @class = "form-control", id = "descriptionTA" })

                        if (TempData["QuoteError"] != null)
                        {
                            <div class="alert alert-danger bold" role="alert">
                                @TempData["QuoteError"]
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            </div>
                        }
                        else if (TempData["QuoteMessage"] != null)
                        {
                            <div class="alert alert-success bold" role="alert">
                                @TempData["QuoteMessage"]
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            </div>
                        }

                        <button class="btn btn-primary float-right" type="submit" id="submitQuoteForm">Submit</button>
                        <button class="btn btn-default float-right" type="reset" onclick="ClearQuoteForm()">Clear</button>
                    }
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript" src="~/Scripts/FormHandler.js"></script>